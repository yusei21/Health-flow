# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Secrets — never commit
.env
.env.*
!.env.example

# Credentialed clinical data (MIMIC-IV-ED) — never commit or redistribute
data/raw/mimic*/
data/raw/mimic-iv-ed*/
*.csv.gz

# Kaggle Triagegeist — downloaded manually, never commit or redistribute; no Kaggle tokens
data/raw/triagegeist/
kaggle.json
.kaggle/

# Generated artifacts (reproducible with `make train`)
models/*
!models/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Editors / OS
.idea/
.vscode/
.DS_Store

# Local benchmark output; existing published aggregates remain tracked.
benchmarks/results/*
!benchmarks/results/.gitkeep

# Test temporary directories when TMPDIR is within the checkout.
pytest-of-root/
