# Copy to frontend/.env (never commit it).
# Backend started with `make dev` / `make dev-backend`.
VITE_API_BASE_URL=http://127.0.0.1:8000
# DEVELOPMENT ONLY: must equal HEALTHFLOW_DEMO_AUTH_TOKEN in the backend .env.
# VITE_* values are embedded in the browser bundle — never put a real secret here.
VITE_DEMO_TOKEN=
