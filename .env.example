# Copy to .env and adjust. Never commit .env.
HEALTHFLOW_APP_ENV=development
HEALTHFLOW_LOG_LEVEL=INFO

# LLM (any OpenAI-compatible endpoint; Ollama by default)
HEALTHFLOW_LLM_BASE_URL=http://localhost:11434/v1
# Inside docker-compose use: http://host.docker.internal:11434/v1
HEALTHFLOW_LLM_MODEL=qwen3:4b
# Ollama ignores the key; a real provider would need a real secret here.
HEALTHFLOW_LLM_API_KEY=ollama
HEALTHFLOW_LLM_TIMEOUT_SECONDS=30
HEALTHFLOW_LLM_MAX_RETRIES=1

# ML artifact produced by `make train`
# The API serves symptom-feature models only (e.g. synthetic-v1), not vitals models.
HEALTHFLOW_ML_MODEL_DIR=models/synthetic-v1
HEALTHFLOW_ML_LOW_CONFIDENCE_THRESHOLD=0.55

# Facility search
HEALTHFLOW_FACILITY_SEARCH_RADIUS_KM=25

# DEVELOPMENT-ONLY demo login (static bearer token -> demo patient).
# Disabled when empty. Refused when HEALTHFLOW_APP_ENV=production.
HEALTHFLOW_DEMO_AUTH_TOKEN=change-me-to-a-long-random-string
HEALTHFLOW_DEMO_USER_ID=7d6f0f3e-2b8a-4c1e-9a52-3f4b8c2d1e90

# DEVELOPMENT-ONLY CORS for the Vite frontend (JSON list). Empty/unset = CORS disabled.
# Never use ["*"] in production (refused when HEALTHFLOW_APP_ENV=production).
HEALTHFLOW_CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Future (Phase F): PostgreSQL + pgvector
POSTGRES_USER=healthflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=healthflow

# Optional experimental Jev planner. Deterministic planner remains the default/fallback.
HEALTHFLOW_HARNESS_PLANNER=deterministic
HEALTHFLOW_JEV_ENABLED=false
HEALTHFLOW_JEV_BASE_URL=https://jevmodel.org
HEALTHFLOW_JEV_MODEL=jev-latest
HEALTHFLOW_JEV_API_KEY=
HEALTHFLOW_JEV_TIMEOUT_SECONDS=5
HEALTHFLOW_JEV_MIN_PROBABILITY=0.70
